# =============================================================================
#  NoneBot2 配置模板
#  安装脚本会自动生成 .env（带随机 token），本文件仅作参考/备份。
#  真正生效的是同目录下的 .env，改完执行： botctl restart nonebot
# =============================================================================

# ------------------------------------------------------------------ 基础
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# 超级用户（NoneBot2 的权限体系），填你自己的 QQ 号
SUPERUSERS=["123456789"]
NICKNAME=["早柚"]
COMMAND_START=["/", ""]

# ------------------------------------------------------------------ NapCat -> NoneBot2（反向 WS）
# NapCat 作为客户端主动连过来，地址是 ws://<本机IP>:8080/onebot/v11/ws
# 这里填的 token 必须和 NapCat WebUI 里那个「WebSocket 客户端」的 token 完全一致，
# 否则会一直返回 403。留空即不校验（不建议在公网环境留空）。
ONEBOT_ACCESS_TOKEN=

# ------------------------------------------------------------------ NoneBot2 -> GsCore
# 插件会去连 ws://{host}:{port}/ws/{botid}，本机部署用 127.0.0.1 即可。
gsuid_core_host=127.0.0.1
gsuid_core_port=8765
gsuid_core_botid=NoneBot2
# 与 GsCore 的 <repo>/data/config.json 里的 WS_TOKEN 保持一致；两边都留空则本机直连不校验。
gsuid_core_ws_token=
